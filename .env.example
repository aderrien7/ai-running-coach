# ── Anthropic ──────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Strava ─────────────────────────────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api
# Set the Authorization Callback Domain to: localhost
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your_strava_client_secret_here

# ── Flask ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_me_to_a_random_64_char_hex_string

# ── LLM Backend ────────────────────────────────────────────────────────────
# "claude" uses Anthropic API (requires ANTHROPIC_API_KEY)
# "ollama" uses a local Ollama server (free, no API key needed)
LLM_BACKEND=claude

# ── Ollama (only if LLM_BACKEND=ollama) ───────────────────────────────────
# Install: https://ollama.com  |  Pull: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
